# Copy to .env. EXPO_PUBLIC_* values are bundled into the app: never put the service-role key or a database URL here.
# The API running on this computer, by its Wi-Fi IP (not localhost): the phone calls it over the network.
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_DEMO_MODE=true
