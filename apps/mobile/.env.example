# Leave EXPO_PUBLIC_API_URL empty (or set EXPO_PUBLIC_USE_MOCK=true) to run on the built-in demo data.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_USE_MOCK=true
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_DEMO_MODE=true
# Doctor push notifications need a development build + the proposed /api/doctor/push-token route.
EXPO_PUBLIC_PUSH_ENABLED=false
