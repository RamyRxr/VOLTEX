# Copy to .env.local and fill in. Never commit real values.

# PostgreSQL (Neon). Not used yet: the demo runs on the in-memory store
# until src/lib/store/index.ts returns a Prisma-backed Repo.
DATABASE_URL=

# Signs the session cookie. 32+ random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Protects /api/jobs/silence (Vercel Cron sends "Authorization: Bearer <CRON_SECRET>").
CRON_SECRET=

# Android SMS gateway: where we POST outbound SMS, and the token it sends us
# on /api/sms/inbound ("Authorization: Bearer <token>" or "x-gateway-token").
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
# Shown in the patient "Envoyer par SMS" button.
SMS_GATEWAY_NUMBER=

# true = shortened timers + visible banner + /dev/sms-simulator (CLAUDE.md §6.8)
DEMO_MODE=true
