# Copy to apps/web/.env and fill in. Never commit .env (it is in .gitignore).

# Supabase → Connect (or Project Settings → Database) → Connection string
# "Transaction pooler", port 6543, add ?pgbouncer=true at the end
DATABASE_URL=
# "Session pooler" or direct connection, port 5432 (used for migrations)
DIRECT_URL=

# Supabase → Project Settings → API Keys
# https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable / "anon public" key (safe in the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret / "service_role" key — SERVER ONLY, never in mobile or browser code
SUPABASE_SERVICE_ROLE_KEY=

# Filled later by the AI developer
LLM_API_KEY=
# 32+ random characters
CRON_SECRET=
DEMO_MODE=true

# true only on a demo Supabase project, to allow `pnpm --filter web db:seed`
ALLOW_DEMO_SEED=
