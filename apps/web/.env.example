# Copy to apps/web/.env and fill in. Never commit .env (it is in .gitignore).

# Supabase → Project Settings → Database → Connection string
DATABASE_URL=            # "Transaction pooler", port 6543, add ?pgbouncer=true at the end
DIRECT_URL=              # "Session pooler" or direct connection, port 5432 (used for migrations)

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=        # https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=   # "anon public" key (safe in the browser)
SUPABASE_SERVICE_ROLE_KEY=       # "service_role" key — SERVER ONLY, never in mobile or browser code

LLM_API_KEY=             # filled later by the AI developer
CRON_SECRET=             # 32+ random characters
DEMO_MODE=true

# Still used by the current prototype until Supabase Auth replaces it:
JWT_SECRET=              # 32+ random characters
