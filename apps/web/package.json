{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:rls": "prisma db execute --file prisma/sql/rls.sql --schema prisma/schema.prisma",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6",
    "@tanstack/react-query": "^5.105.0",
    "jose": "^6.2.14",
    "next": "^15.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shared": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.0",
    "playwright": "^1.64.1",
    "prisma": "^6",
    "typescript": "^5.7.0",
    "vitest": "^5.0.5"
  }
}
